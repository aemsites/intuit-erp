{
  "name": "of1-deep-dive-longform",
  "intent": "deep-dive",
  "description": "Single-column editorial explainer: hero, overview, numbered capability grid, image+checklist split, pull quote, CTA. Best for one topic explained in depth.",
  "minItems": 3,
  "maxItems": 4,
  "stylesheet": "/styles/of1-deep-dive-longform.css",
  "html": "/templates/of1-deep-dive-longform.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short kicker, e.g. DEEP DIVE" },
    { "key": "hero.title", "type": "text", "instruction": "Topic headline, <=8 words" },
    { "key": "hero.lede", "type": "text", "instruction": "1-2 sentence summary of the topic" },
    { "key": "hero.cta", "type": "link", "instruction": "Primary action link" },
    { "key": "hero.image", "type": "image", "instruction": "Hero product/screen image URL" },
    { "key": "overview.eyebrow", "type": "text", "instruction": "Kicker, e.g. THE SHORT VERSION" },
    { "key": "overview.title", "type": "text", "instruction": "Overview headline, <=8 words" },
    { "key": "overview.body", "type": "text", "instruction": "2-3 sentence plain-language intro" },
    { "key": "caps.title", "type": "text", "instruction": "Section heading for capabilities" },
    { "key": "item-1.title", "type": "text", "instruction": "Capability name, <=4 words" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence explanation" },
    { "key": "item-2.title", "type": "text", "instruction": "Capability name, <=4 words" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence explanation" },
    { "key": "item-3.title", "type": "text", "instruction": "Capability name, <=4 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence explanation" },
    { "key": "item-4.title", "type": "text", "instruction": "Capability name, <=4 words" },
    { "key": "item-4.body", "type": "text", "instruction": "1-sentence explanation" },
    { "key": "detail.image", "type": "image", "instruction": "Supporting screenshot URL" },
    { "key": "detail.eyebrow", "type": "text", "instruction": "Kicker, e.g. A CLOSER LOOK" },
    { "key": "detail.title", "type": "text", "instruction": "Detail headline, <=8 words" },
    { "key": "detail.body", "type": "text", "instruction": "2-sentence deeper explanation" },
    { "key": "detail.points", "type": "list", "instruction": "3 short benefit bullets" },
    { "key": "quote.text", "type": "text", "instruction": "Customer quote, 1 sentence" },
    { "key": "quote.attribution", "type": "text", "instruction": "Name, title, company" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline" },
    { "key": "cta.body", "type": "text", "instruction": "1-sentence CTA supporting copy" },
    { "key": "cta.button", "type": "link", "instruction": "CTA action link" }
  ]
}
