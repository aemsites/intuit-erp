{
  "name": "of1-comparison-table",
  "intent": "comparison",
  "description": "Side-by-side feature columns for 2-4 options with a shared feature checklist and key-differences list.",
  "minItems": 2,
  "maxItems": 4,
  "stylesheet": "/styles/of1-comparison-table.css",
  "html": "/templates/of1-comparison-table.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short kicker, 2-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Comparison headline, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of what is being compared" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary CTA to the comparison" },
    { "key": "hero.cta-secondary", "type": "link", "instruction": "Secondary CTA to talk to sales" },
    { "key": "hero.image", "type": "image", "instruction": "Hero product/dashboard image URL" },
    { "key": "intro.title", "type": "text", "instruction": "Section heading, <=6 words" },
    { "key": "intro.body", "type": "text", "instruction": "1-sentence intro to the comparison" },
    { "key": "item-1.title", "type": "text", "instruction": "Option 1 name" },
    { "key": "item-1.tagline", "type": "text", "instruction": "Option 1 positioning line, <=8 words" },
    { "key": "item-1.image", "type": "image", "instruction": "Option 1 image URL" },
    { "key": "item-1.features", "type": "list", "instruction": "3-4 capabilities for option 1" },
    { "key": "item-1.cta", "type": "link", "instruction": "Option 1 link" },
    { "key": "item-2.title", "type": "text", "instruction": "Option 2 name" },
    { "key": "item-2.tagline", "type": "text", "instruction": "Option 2 positioning line, <=8 words" },
    { "key": "item-2.image", "type": "image", "instruction": "Option 2 image URL" },
    { "key": "item-2.features", "type": "list", "instruction": "3-4 capabilities for option 2" },
    { "key": "item-2.cta", "type": "link", "instruction": "Option 2 link" },
    { "key": "item-3.title", "type": "text", "instruction": "Option 3 name" },
    { "key": "item-3.tagline", "type": "text", "instruction": "Option 3 positioning line, <=8 words" },
    { "key": "item-3.image", "type": "image", "instruction": "Option 3 image URL" },
    { "key": "item-3.features", "type": "list", "instruction": "3-4 capabilities for option 3" },
    { "key": "item-3.cta", "type": "link", "instruction": "Option 3 link" },
    { "key": "item-4.title", "type": "text", "instruction": "Option 4 name" },
    { "key": "item-4.tagline", "type": "text", "instruction": "Option 4 positioning line, <=8 words" },
    { "key": "item-4.image", "type": "image", "instruction": "Option 4 image URL" },
    { "key": "item-4.features", "type": "list", "instruction": "3-4 capabilities for option 4" },
    { "key": "item-4.cta", "type": "link", "instruction": "Option 4 link" },
    { "key": "differences.title", "type": "text", "instruction": "Heading for the differences list" },
    { "key": "differences.points", "type": "list", "instruction": "3-5 key differences between the options" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline" },
    { "key": "cta.body", "type": "text", "instruction": "1-sentence CTA supporting line" },
    { "key": "cta.button", "type": "link", "instruction": "Closing CTA link" }
  ]
}
