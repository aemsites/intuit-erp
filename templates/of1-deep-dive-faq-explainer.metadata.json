    { "key": "item-3.tab-label", "type": "text", "instruction": "Tab label, <=3 words" },
    { "key": "item-3.eyebrow", "type": "text", "instruction": "Panel kicker (uppercase)" },
    { "key": "item-3.title", "type": "text", "instruction": "Panel headline, <=8 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-2 sentence panel explanation" },
    { "key": "faq.title", "type": "text", "instruction": "FAQ section heading" },
