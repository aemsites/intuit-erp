    { "key": "hero.lede", "type": "text", "instruction": "1-sentence framing of the answer" },
    { "key": "answer.eyebrow", "type": "text", "instruction": "Kicker, e.g. THE SHORT ANSWER" },
    { "key": "answer.title", "type": "text", "instruction": "Direct answer headline, <=8 words" },
    { "key": "answer.body", "type": "text", "instruction": "2-sentence direct answer" },
    { "key": "tabs.title", "type": "text", "instruction": "Heading for the tabbed explainer" },
    { "key": "item-1.tab-label", "type": "text", "instruction": "Tab label, <=3 words" },
    { "key": "item-1.eyebrow", "type": "text", "instruction": "Panel kicker (uppercase)" },
    { "key": "item-1.title", "type": "text", "instruction": "Panel headline, <=8 words" },
