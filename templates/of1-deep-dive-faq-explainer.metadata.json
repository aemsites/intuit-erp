{
  "name": "of1-deep-dive-faq-explainer",
  "intent": "deep-dive",
  "description": "Q&A explainer: centered hero, short-answer block, 3-tab interactive explainer, FAQ accordion, CTA. Best when the topic is a question with follow-ups.",
  "minItems": 3,
  "maxItems": 4,
  "stylesheet": "/styles/of1-deep-dive-faq-explainer.css",
  "html": "/templates/of1-deep-dive-faq-explainer.html",
  "slots": [
