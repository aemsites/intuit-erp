{
  "name": "of1-recommendation-hero-pick",
  "intent": "recommendation",
  "description": "One dominant top pick in a full-width spotlight card, three ranked reasons it fits, then two smaller runner-up options.",
  "minItems": 3,
  "maxItems": 5,
  "stylesheet": "/styles/of1-recommendation-hero-pick.css",
  "html": "/templates/of1-recommendation-hero-pick.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short kicker, e.g. YOUR RECOMMENDED MATCH" },
    { "key": "hero.title", "type": "text", "instruction": "Headline framing the pick, <=8 words" },
    { "key": "hero.lede", "type": "text", "instruction": "1-sentence why-this-fit summary" },
    { "key": "hero.cta", "type": "link", "instruction": "Jump to the top pick" },
    { "key": "hero.image", "type": "image", "instruction": "Hero product/dashboard image URL" },
    { "key": "pick.badge", "type": "text", "instruction": "Badge label, e.g. TOP PICK FOR YOU" },
    { "key": "pick.image", "type": "image", "instruction": "Top-pick product image URL" },
    { "key": "pick.title", "type": "text", "instruction": "Top-pick product name" },
    { "key": "pick.body", "type": "text", "instruction": "1-2 sentence value proposition" },
    { "key": "pick.features", "type": "list", "instruction": "3 key features of the pick" },
    { "key": "pick.cta", "type": "link", "instruction": "Link to the pick's product page" },
    { "key": "reasons.title", "type": "text", "instruction": "Section heading for the fit reasons" },
    { "key": "item-1.title", "type": "text", "instruction": "Reason 1 title" },
    { "key": "item-1.body", "type": "text", "instruction": "Reason 1, 1 sentence" },
    { "key": "item-2.title", "type": "text", "instruction": "Reason 2 title" },
    { "key": "item-2.body", "type": "text", "instruction": "Reason 2, 1 sentence" },
    { "key": "item-3.title", "type": "text", "instruction": "Reason 3 title" },
    { "key": "item-3.body", "type": "text", "instruction": "Reason 3, 1 sentence" },
    { "key": "alts.title", "type": "text", "instruction": "Runner-ups section heading" },
    { "key": "item-4.image", "type": "image", "instruction": "Runner-up 1 image URL" },
    { "key": "item-4.title", "type": "text", "instruction": "Runner-up 1 product name" },
    { "key": "item-4.body", "type": "text", "instruction": "Runner-up 1, 1 sentence" },
    { "key": "item-4.cta", "type": "link", "instruction": "Link to runner-up 1 page" },
    { "key": "item-5.image", "type": "image", "instruction": "Runner-up 2 image URL" },
    { "key": "item-5.title", "type": "text", "instruction": "Runner-up 2 product name" },
    { "key": "item-5.body", "type": "text", "instruction": "Runner-up 2, 1 sentence" },
    { "key": "item-5.cta", "type": "link", "instruction": "Link to runner-up 2 page" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline" },
    { "key": "cta.body", "type": "text", "instruction": "Closing CTA supporting line" },
    { "key": "cta.button", "type": "link", "instruction": "Primary CTA link" }
  ]
}
