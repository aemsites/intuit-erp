{
  "name": "of1-comparison-pros-cons",
  "intent": "comparison",
  "description": "Tabbed pros-and-cons breakdown of 2-3 options with per-option upside/downside columns and a best-for summary.",
  "minItems": 2,
  "maxItems": 3,
  "stylesheet": "/styles/of1-comparison-pros-cons.css",
  "html": "/templates/of1-comparison-pros-cons.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short kicker, 2-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Pros/cons headline, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of the trade-offs" },
    { "key": "hero.cta", "type": "link", "instruction": "Hero CTA to the breakdown" },
    { "key": "hero.image", "type": "image", "instruction": "Hero product/dashboard image URL" },
    { "key": "intro.title", "type": "text", "instruction": "Section heading, <=6 words" },
    { "key": "intro.body", "type": "text", "instruction": "1-sentence intro to the tabs" },
    { "key": "item-1.title", "type": "text", "instruction": "Option 1 name (also the tab label)" },
    { "key": "item-1.tagline", "type": "text", "instruction": "Option 1 positioning line, <=10 words" },
    { "key": "item-1.pros", "type": "list", "instruction": "3-4 upsides of option 1" },
    { "key": "item-1.cons", "type": "list", "instruction": "2-3 downsides of option 1" },
    { "key": "item-2.title", "type": "text", "instruction": "Option 2 name (also the tab label)" },
    { "key": "item-2.tagline", "type": "text", "instruction": "Option 2 positioning line, <=10 words" },
    { "key": "item-2.pros", "type": "list", "instruction": "3-4 upsides of option 2" },
    { "key": "item-2.cons", "type": "list", "instruction": "2-3 downsides of option 2" },
    { "key": "item-3.title", "type": "text", "instruction": "Option 3 name (also the tab label)" },
    { "key": "item-3.tagline", "type": "text", "instruction": "Option 3 positioning line, <=10 words" },
    { "key": "item-3.pros", "type": "list", "instruction": "3-4 upsides of option 3" },
    { "key": "item-3.cons", "type": "list", "instruction": "2-3 downsides of option 3" },
    { "key": "bestfor.title", "type": "text", "instruction": "Heading for the best-for section" },
    { "key": "best-1.title", "type": "text", "instruction": "Best-for card 1 label, e.g. option name" },
    { "key": "best-1.body", "type": "text", "instruction": "Who option 1 fits best, 1 sentence" },
    { "key": "best-2.title", "type": "text", "instruction": "Best-for card 2 label, e.g. option name" },
    { "key": "best-2.body", "type": "text", "instruction": "Who option 2 fits best, 1 sentence" },
    { "key": "best-3.title", "type": "text", "instruction": "Best-for card 3 label, e.g. option name" },
    { "key": "best-3.body", "type": "text", "instruction": "Who option 3 fits best, 1 sentence" },
    { "key": "bottomline.eyebrow", "type": "text", "instruction": "Kicker, e.g. The bottom line" },
    { "key": "bottomline.title", "type": "text", "instruction": "Recommendation headline, <=5 words" },
    { "key": "bottomline.body", "type": "text", "instruction": "1-2 sentence honest recommendation" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline" },
    { "key": "cta.body", "type": "text", "instruction": "1-sentence CTA supporting line" },
    { "key": "cta.button", "type": "link", "instruction": "Closing CTA link" }
  ]
}
