{
  "name": "of1-deep-dive-timeline",
  "intent": "deep-dive",
  "description": "Vertical numbered step-by-step walkthrough: hero, intro, 4-step timeline rail, outcome stat band, CTA. Best for explaining a process or workflow in order.",
  "minItems": 4,
  "maxItems": 7,
  "stylesheet": "/styles/of1-deep-dive-timeline.css",
  "html": "/templates/of1-deep-dive-timeline.html",
  "slots": [
