    { "key": "item-7.description", "type": "text", "instruction": "What the stat measures" },
    { "key": "item-7.company", "type": "text", "instruction": "Customer name" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline" },
    { "key": "cta.body", "type": "text", "instruction": "1-sentence CTA supporting copy" },
    { "key": "cta.button", "type": "link", "instruction": "CTA action link" }
