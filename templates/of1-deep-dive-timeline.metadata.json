    { "key": "hero.title", "type": "text", "instruction": "Process headline, <=8 words" },
    { "key": "hero.lede", "type": "text", "instruction": "1-2 sentence summary of the workflow" },
    { "key": "hero.cta", "type": "link", "instruction": "Primary action link" },
    { "key": "hero.image", "type": "image", "instruction": "Hero product/screen image URL" },
    { "key": "intro.title", "type": "text", "instruction": "Section heading for the steps" },
    { "key": "intro.body", "type": "text", "instruction": "1-2 sentence framing of the steps" },
    { "key": "item-1.phase", "type": "text", "instruction": "Step label, e.g. STEP 1" },
    { "key": "item-1.title", "type": "text", "instruction": "Step name, <=4 words" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence description of the step" },
    { "key": "item-2.phase", "type": "text", "instruction": "Step label, e.g. STEP 2" },
