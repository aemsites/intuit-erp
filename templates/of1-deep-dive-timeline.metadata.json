    { "key": "item-3.phase", "type": "text", "instruction": "Step label, e.g. STEP 3" },
    { "key": "item-3.title", "type": "text", "instruction": "Step name, <=4 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence description of the step" },
    { "key": "item-4.phase", "type": "text", "instruction": "Step label, e.g. STEP 4" },
    { "key": "item-4.title", "type": "text", "instruction": "Step name, <=4 words" },
    { "key": "item-4.body", "type": "text", "instruction": "1-sentence description of the step" },
    { "key": "stats.title", "type": "text", "instruction": "Heading for outcome stats" },
