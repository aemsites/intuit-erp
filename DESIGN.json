    "text-muted": "#6b6c72",
    "text-soft": "#8d9096",
    "primary": "#0077c5",
    "primary-dark": "#055393",
    "navy": "#00254a",
    "navy-hover": "#001a36",
    "navy-mid": "#053d6d",
    "ink-teal": "#0d333f",
    "blue-bright": "#0097e6",
    "blue-light": "#34bfff",
    "accent-green": "#0a8543",
    "accent-green-bright": "#0fd46c",
    "info-band": "#236cff"
  },
  "typography": {
    "brandFamily": "AvenirNext forINTUIT",
    "substituteFamily": "Mulish",
    "stack": "\"AvenirNext forINTUIT\", Mulish, Helvetica, Arial, sans-serif",
