{
	"name": "intuit-edge",
	"main": "src/index.js",
	"account_id": "ac7ee4615628005dc5ba0a22f0aae2a6",
	"compatibility_date": "2026-08-05",
	"observability": {
		"enabled": true
	},
	"vars": {
		// aem.live origin the worker proxies pages from.
		"ORIGIN_BASE_URL": "https://main--intuit-erp--aemsites.aem.live",
		// Entry source: "de" (Decision Engine batch flow, default) or "ixp" (the
		// IXP Assignment API). A ?pzn=de|ixp query param overrides this per request.
		"PZN_SOURCE": "de",
		// IXP Assignment API host (PZN_SOURCE=ixp / ?pzn=ixp). The key it
		// authenticates with is the `IXP_API_KEY` Wrangler secret (never in
		// vars/committed) — set it with `wrangler secret put IXP_API_KEY`.
		"IXP_ASSIGNMENT_URL": "https://experimentation.us.api.intuit.com/us/v2/assignment",
		// IXP mock: when "enabled", /api/audiences resolves the sticky arm from the
		// in-worker mock (src/ixp/mock.js) instead of the real host — so the IXP
		// redirect A/B demo runs without the (currently 403) key. Swap to the real
		// service by removing this and setting the IXP_API_KEY secret.
		"IXP_MOCK": "enabled",
		// Decision Engine flow (PZN_SOURCE=de / ?pzn=de). The batch client POSTs the
		// page's slots + visitor attributes here and renders the returned per-slot
		// recommendation (`copyData.pznblock` fragment). The API key it authenticates
		// with is the `PZN_API_KEY` Wrangler secret (never in vars/committed) — set it
		// with `wrangler secret put PZN_API_KEY`.
		"DECISION_ENGINE_BATCH_URL": "https://personalization.api.intuit.com/public/v1/batch",
		// DE mock: when "enabled", /api/pzn-manifest.json resolves the per-visitor
		// offer from the in-worker mock (src/de/mock.js) instead of the real Batch
		// endpoint — so the DE slot demo runs without the (rotation-pending) key.
		// Swap to the real service by removing this and setting the PZN_API_KEY secret.
		"DE_MOCK": "enabled",
		// Ask the origin to enable push invalidation (set to "disabled" to skip).
		"PUSH_INVALIDATION": "disabled",
		// Path prefixes whose `.json` (when the origin 404s) is served from the
		// da-sc structured-content source instead of mhast html-to-json.
		"STRUCTURED_CONTENT_PATHS": ["/events/"],
		// EDGE_AUTH_SECRET (Wrangler secret, optional) gates the /api/* endpoints:
		// when set, requests must carry a matching `x-edge-auth` header (injected by
		// Akamai on the /api/* route). Unset ⇒ the check is skipped. Set it with
		// `wrangler secret put EDGE_AUTH_SECRET`.
	}
}
