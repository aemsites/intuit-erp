{
  "name": "aem-intuit-erp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "golden:customer": "node scripts/diff/payloads-to-golden.mjs",
    "contract:audit": "node scripts/diff/contract-audit.mjs",
    "golden:crosscheck": "node scripts/diff/golden-crosscheck.mjs",
    "partytown:copy": "partytown copylib scripts/partytown --no-debug",
    "sheet:customer": "node scripts/diff/gen-sheet-from-golden.mjs --golden scripts/diff/fixtures/local/clicktrack-golden-customer.json --out scripts/diff/fixtures/local/tracking-sheet-customer.json",
    "oracle:customer": "npm run --silent sheet:customer && node scripts/diff/customer-oracle.mjs",
    "oracle:customer:floor": "node scripts/diff/customer-oracle.mjs --sheet /nonexistent",
    "coverage:customer": "node scripts/diff/coverage-matrix.mjs --golden scripts/diff/fixtures/local/clicktrack-golden-customer.json --sheet scripts/diff/fixtures/local/tracking-sheet-customer.json --out CLICK-TRACKING-COVERAGE-customer.md",
    "stage:parity": "node scripts/diff/stage-parity.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.7",
    "@qwik.dev/partytown": "0.14.3",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.62.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "vitest": "^2.1.0"
  }
}
